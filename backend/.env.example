# PostgreSQL connection string (Render, Supabase, Railway, etc.)
DATABASE_URL="postgresql://user:password@host:5432/maison_utsav?schema=public"

# JWT secret for admin auth cookies — generate a long random string
JWT_SECRET="replace-with-a-long-random-secret"

# Cloudinary (Settings -> API Keys on cloudinary.com)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Comma-separated list of origins allowed to call this API
# e.g. https://your-site.vercel.app,http://localhost:5500
#
# IMPORTANT for local testing: opening the frontend HTML files directly
# by double-clicking them (a file:// URL) makes the browser send
# "Origin: null" on every fetch — if "null" isn't in this list, every
# API call (Admin Login, Rent Now, etc.) fails with "Failed to fetch".
# Either add "null" below for local testing, or better: serve the
# frontend folder with a real local server instead of file://, e.g.
#   npx http-server frontend -p 5500
# and use that http://localhost:5500 origin here instead.
CORS_ORIGINS="http://localhost:5500,http://127.0.0.1:5500,null"

# Port the server listens on (Render sets this automatically in production)
PORT=4000

# Node env
NODE_ENV=development

# ---- User Login / Profile module ----
# Uses the SAME Postgres database as everything else (a `User` table
# alongside Admin) — no separate database needed.

# Email OTP — any SMTP account works (Gmail app password, SendGrid, etc.)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# SMS OTP — generic REST provider. Left blank, OTP codes are logged to the
# server console instead (fine for testing, not for production).
# For Twilio: SMS_PROVIDER_URL = your Messages API endpoint,
#   SMS_PROVIDER_AUTH_HEADER = "Basic <base64 of ACCOUNT_SID:AUTH_TOKEN>"
# For MSG91 or others, adapt src/lib/otpProviders.js's request body to match.
SMS_PROVIDER_URL=""
SMS_PROVIDER_AUTH_HEADER=""

# ---- Payment gateway (Rent Now checkout) ----
# Not wired in yet — Cash on Delivery works out of the box, but UPI/Card/
# Netbanking orders stay "Pending Payment" until a gateway is connected.
# Add your provider's keys here once chosen (Razorpay/Stripe/PayU/etc.)
# and point its success webhook at POST /api/orders/:id/confirm-payment.
PAYMENT_GATEWAY=""
PAYMENT_GATEWAY_KEY=""
PAYMENT_GATEWAY_SECRET=""
